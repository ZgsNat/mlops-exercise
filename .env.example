# ==========================================
# MLOps Pipeline Environment Configuration
# ==========================================

# Project & Model Config
MODEL_NAME=wine-classifier
MODEL_VERSION=1
MODEL_ALIAS=champion
EXPERIMENT_NAME=wine-classification-pipeline

# Database (PostgreSQL)
POSTGRES_USER=mlops
POSTGRES_PASSWORD=mlopspass
POSTGRES_DB=mlops_db
POSTGRES_PORT=15433

# MinIO Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword
MINIO_BUCKET=mlflow
MINIO_API_PORT=19020
MINIO_CONSOLE_PORT=19021

# MLflow Tracking & Registry
MLFLOW_PORT=15030
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=miniopassword
AWS_DEFAULT_REGION=us-east-1

# Apache Airflow
AIRFLOW_PORT=18080
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# FastAPI Serving
API_PORT=18013

# Host System Settings (UID for Linux volumes; macOS/Windows keep 0)
UID_GID=0
